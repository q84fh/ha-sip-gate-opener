# cp .env.example .env && chmod 600 .env
# Generate with: openssl rand -base64 32   (changing it invalidates all links)
GATE_SECRET=
# Home Assistant webhook, reachable from this container (HA itself does not need to be public).
GATE_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/CHANGE_ME_WEBHOOK_ID
# Public address of this app, used in generated links.
GATE_BASE_URL=https://gate.example.com
# Your gate's cycle: opening, staying open, closing.
GATE_OPENING=25s
GATE_OPEN_HOLD=10s
GATE_CLOSING=25s
# Language for browsers that prefer neither English nor Polish: en | pl
GATE_LANG=en
TZ=Europe/Warsaw
# Header with the guest's IP that your reverse proxy always sets: X-Real-IP (nginx, Traefik)
# or CF-Connecting-IP (Cloudflare Tunnel). Leave empty if the app is reached directly.
# Used only for logs and the webhook payload.
GATE_IP_HEADER=X-Real-IP
# Revoked link IDs (shown by `token`/`inspect`), comma-separated; restart after changing.
GATE_REVOKED=
